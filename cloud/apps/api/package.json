{
  "name": "@freekiosk-manager/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "dev": "prisma generate && tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "openapi": "node --env-file-if-exists=../../.env dist/openapi.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 --env-file-if-exists=../../.env.test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "adbkit-apkreader": "3.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "express": "^5.1.0",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/yauzl": "2.10.3",
    "concurrently": "9.2.4",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
