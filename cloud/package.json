{
  "name": "freekiosk-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Website tự vận hành để quản lý thiết bị FreeKiosk",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev --workspace @freekiosk-manager/api\" \"npm run dev --workspace @freekiosk-manager/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspace @freekiosk-manager/api",
    "db:migrate": "npm run db:migrate --workspace @freekiosk-manager/api",
    "openapi": "npm run openapi --workspace @freekiosk-manager/api"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  }
}
