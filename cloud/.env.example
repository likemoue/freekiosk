# Tạo tệp .env tự động: sh deploy/init-env.sh
# Hoặc chép tệp này thành .env và điền tay.

# Địa chỉ công khai của website, đúng như tablet và trình duyệt truy cập, không có dấu / ở cuối.
# Tablet lưu địa chỉ này khi đăng ký: đổi sau đó thì phải đăng ký lại các tablet.
PUBLIC_URL=https://kiosk.ism.io.vn

# Cổng mở cho Nginx Proxy Manager. BIND_ADDRESS là IP LAN của VM Ubuntu này.
BIND_ADDRESS=172.16.8.186
GATEWAY_PORT=8090

# Cơ sở dữ liệu: chỉ dùng trong mạng Docker, không mở ra ngoài. Mật khẩu chỉ gồm chữ và số.
POSTGRES_DB=freekiosk
POSTGRES_USER=freekiosk
POSTGRES_PASSWORD=doi-gia-tri-nay

# Khóa mã hóa thông tin bí mật và ký liên kết media, ít nhất 32 ký tự.
# ĐỪNG đổi sau khi đã có dữ liệu: PIN, mật khẩu đã lưu sẽ không giải mã được, liên kết media đổi hết.
# Tạo bằng: openssl rand -hex 32
APP_SECRET=doi-gia-tri-nay

# Tài khoản quản trị đầu tiên, chỉ dùng khi chưa có người dùng nào.
# Mật khẩu này phải đổi ngay ở lần đăng nhập đầu.
ADMIN_EMAIL=admin@ism.io.vn
ADMIN_PASSWORD=doi-gia-tri-nay

# Tên tổ chức ban đầu, đổi được trong Cài đặt.
ORG_NAME=iSMART

# Lấy IP thật của tablet từ tiêu đề CF-Connecting-IP. Để true khi đi qua Cloudflare.
TRUST_CF_HEADER=true

# Không bắt buộc
# SESSION_DAYS=7
# ENROLLMENT_TOKEN_HOURS=24
# MEDIA_QUOTA_GB=20
